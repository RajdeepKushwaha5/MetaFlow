# OpenMetadata AI SDK
AI_SDK_HOST=http://localhost:8585
AI_SDK_TOKEN=your_openmetadata_pat_here

# LLM Provider (Google Gemini — free tier)
GOOGLE_API_KEY=your_google_api_key_here
