# OpenMetadata AI SDK
AI_SDK_HOST=http://localhost:8585
AI_SDK_TOKEN=your_openmetadata_pat_here

# LLM Provider (Google Gemini — free tier)
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional integrations — Multi-MCP
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxxx
GITHUB_TOKEN=ghp_your_github_pat_here
GITHUB_DEFAULT_REPO=your-org/metadata-ops
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account.json

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Jira
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=DATA

# Notion
NOTION_API_KEY=secret_your_notion_key
NOTION_DATABASE_ID=your_database_uuid

# Webhook secret (optional, for verifying OM alert payloads)
WEBHOOK_SECRET=

# Server config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────
# Demo + Steward
# ─────────────────────────────────────────────────────────────────────

# DEMO_MODE=true short-circuits Slack/Jira/Notion/Google/Email/GitHub
# tools to deterministic fixtures so demos never hit network failures.
DEMO_MODE=false

# Auto-start the Continuous Data Steward background loop on boot.
# Polls OM /api/v1/events, classifies, takes autonomous action,
# exposes a daily digest at /api/steward/digest.
STEWARD_ENABLED=false
STEWARD_POLL_SECONDS=60

# Judge Mode — one-flag config that points at the public OM sandbox
# (sandbox.open-metadata.org), enables the autonomous Steward, and
# leaves DEMO_MODE off so the demo runs against REAL OpenMetadata.
JUDGE_MODE=false
SANDBOX_HOST=https://sandbox.open-metadata.org

# ─────────────────────────────────────────────────────────────────────
# OAuth 2.0 client-credentials for OpenMetadata MCP / REST
# ─────────────────────────────────────────────────────────────────────
# When all three of TOKEN_URL / CLIENT_ID / CLIENT_SECRET are set,
# MetaFlow runs the standard `client_credentials` OAuth grant against
# your OIDC provider (Okta, Auth0, Keycloak, Google) and auto-refreshes
# the bearer token before it expires. Falls back to AI_SDK_TOKEN (PAT)
# if any of the three is missing.
OM_OAUTH_TOKEN_URL=
OM_OAUTH_CLIENT_ID=
OM_OAUTH_CLIENT_SECRET=
OM_OAUTH_SCOPE=
OM_OAUTH_AUDIENCE=

# ─────────────────────────────────────────────────────────────────────
# Native AI SDK conversations (server-side multi-turn history in OM)
# ─────────────────────────────────────────────────────────────────────
# When true, MetaFlow stores chat history server-side via the AI SDK's
# Conversations API instead of local SQLite. Other OM-aware clients
# can then read the same threads. Falls back to local SQLite if the
# connected AI SDK build doesn't expose `client.conversations`.
USE_AI_SDK_CONVERSATIONS=false
